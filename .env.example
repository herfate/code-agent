# Anthropic (Claude Agent SDK)
ANTHROPIC_API_KEY=

# OpenAI / Codex (@openai/codex-sdk — see package README for CLI if required)
OPENAI_API_KEY=

# Cursor (@cursor/sdk — Local agent against task-repo or cwd)
CURSOR_API_KEY=

# Pending-task scan: which agent SDK to use (claude | cursor)
# TASK_AGENT_PROVIDER=claude

# Optional: full path to `codex` CLI if not on PATH (SDK spawns Codex)
CODEX_PATH=

# Server
PORT=30001
HOST=127.0.0.1

# SQLite file path (directory will be created if missing)
DATABASE_PATH=./data/app.db

# Pending-task scan: interval in ms (0 = off). Each tick lists pending (FIFO), claims pending→running, runs handleClaimedTask.
# TASK_SCAN_INTERVAL_MS=30000
# TASK_SCAN_BATCH_SIZE=10

# Confluence Server（/confluence/page-tree-to-markdown → zip 下载；Basic Auth + cfxmark）
# CONFLUENCE_BASE_URL=https://wiki.example.com/wiki
# CONFLUENCE_USERNAME=
# CONFLUENCE_PASSWORD=
# 本地 Markdown 输出目录（默认 ./confluence_out）
# CONFLUENCE_OUTPUT_DIR=./confluence_out
# cfxmark 转换用 Python 3.10+ 可执行文件（Windows 建议写完整路径，避免 9009）
# CFXMARK_PYTHON=C:\Users\你\AppData\Local\Programs\Python\Python310\python.exe
