# Anthropic (Claude Agent SDK)
ANTHROPIC_API_KEY=

# OpenAI / Codex (@openai/codex-sdk — see package README for CLI if required)
OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=

# 多模态 Vision（multimodalUtil；与 OPENAI_* 独立）
# MULTIMODAL_API_KEY=
# MULTIMODAL_BASE_URL=
# MULTIMODAL_MODEL=

# Cursor (@cursor/sdk — Local agent against task-repo or cwd)
CURSOR_API_KEY=

# Pending-task scan: which agent SDK to use (claude | cursor)
# TASK_AGENT_PROVIDER=claude

# Optional: full path to `codex` CLI if not on PATH (SDK spawns Codex)
CODEX_PATH=

# Server
PORT=30001
HOST=127.0.0.1

# SQLite file path (directory will be created if missing)
DATABASE_PATH=./data/app.db

# Pending-task scan: interval in ms (0 = off). Each tick lists pending (FIFO), claims pending→running, runs handleClaimedTask.
# TASK_SCAN_INTERVAL_MS=30000
# TASK_SCAN_BATCH_SIZE=5

# Wiki Confluence / 代码库 每日定时同步（本地时区）；Confluence → wiki_base，代码库 → code_base；-1 关闭
# WIKI_SYNC_DAILY_HOUR=1
# WIKI_SYNC_DAILY_MINUTE=0
# 是否定时自动创建知识沉淀父任务（类型 7）；默认 false
# WIKI_SYNC_CREATE_PERSIST_MEMORY=false

# Wiki 智能问答是否允许选择 Cursor 线路；false 时前端禁用 Cursor 并提示（如未续费等）
# WIKI_QA_CURSOR_ENABLED=true
# 禁用 Cursor 时展示的提示文案
# WIKI_QA_CURSOR_DISABLED_REASON=cursor没钱了等下周一开放

# Confluence Server（/confluence/page-tree-to-markdown → zip 下载；Basic Auth + cfxmark）
# CONFLUENCE_BASE_URL=https://wiki.example.com/wiki
# CONFLUENCE_USERNAME=
# CONFLUENCE_PASSWORD=
# 本地 Markdown 输出目录（默认 ./confluence_out）
# CONFLUENCE_OUTPUT_DIR=./confluence_out
# cfxmark 转换用 Python 3.10+ 可执行文件（Windows 建议写完整路径，避免 9009）
# CFXMARK_PYTHON=C:\Users\你\AppData\Local\Programs\Python\Python310\python.exe

# OCR.space API（图片 OCR，Engine 3）—— https://ocr.space/ocrapi 免费注册（Free：25,000 次/月 + Engine 3 额外 2,500 次/月）
OCR_SPACE_API_KEY=
# 可选：PRO 专线端点；默认 https://api.ocr.space/parse/image
# OCR_SPACE_API_URL=

# SSH 快速验证（npm run ssh:verify）；密码与私钥二选一
# SSH_HOST=10.14.100.31
# SSH_PORT=22222
# SSH_USER=jiangwei.ji
# SSH_PASSWORD=
# 经堡垒机穿透到内网（齐治/SSHD 用户名格式：{SSH_USER}@{SSH_TARGET_USER}@{SSH_TARGET_HOST}）
# SSH_TARGET_HOST=10.11.102.101
# SSH_TARGET_USER=log
# 设为 false 时仅验证堡垒机本身（不穿透）
# SSH_USE_PIERCE=true
# 远程执行命令（npm run ssh:verify -- "hostname" 或配置 SSH_COMMAND）
# SSH_COMMAND=hostname
# SSH_COMMAND_TIMEOUT_MS=120000
# SSH_PASSWORD=
# SSH_PRIVATE_KEY=C:\Users\你\.ssh\id_rsa
# SSH_PASSPHRASE=
