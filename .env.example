# Anthropic (Claude Agent SDK)
ANTHROPIC_API_KEY=

# OpenAI / Codex (@openai/codex-sdk — see package README for CLI if required)
OPENAI_API_KEY=

# Optional: full path to `codex` CLI if not on PATH (SDK spawns Codex)
CODEX_PATH=

# Server
PORT=30001
HOST=127.0.0.1

# SQLite file path (directory will be created if missing)
DATABASE_PATH=./data/app.db
