{
  "name": "code-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "chcp 65001 >nul 2>&1 & tsx watch src/server.ts",
    "dev:css": "tailwindcss -i ./src/styles/tailwind.css -o ./public/app.css --watch",
    "build:css": "tailwindcss -i ./src/styles/tailwind.css -o ./public/app.css --minify",
    "build": "npm run build:css && tsc",
    "start": "node dist/server.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.139",
    "@cursor/sdk": "^1.0.14",
    "@fastify/static": "^9.1.3",
    "@openai/codex-sdk": "^0.130.0",
    "archiver": "^8.0.0",
    "dotenv": "^16.5.0",
    "fastify": "^5.3.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
